# Application Settings
PROJECT_NAME="ARGO Oceanographic Float Backend"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Server Host & Port
HOST="0.0.0.0"
PORT=8000

# CORS Configuration (comma-separated list of allowed origins)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"

# PostgreSQL + PostGIS Database Configuration
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="argo_user"
POSTGRES_PASSWORD="argo_password"
POSTGRES_DB="argo_db"

# Direct SQLAlchemy Database URLs (Optional override)
# Async driver: postgresql+asyncpg://argo_user:argo_password@localhost:5432/argo_db
# Sync driver (for Alembic): postgresql+psycopg2://argo_user:argo_password@localhost:5432/argo_db
DATABASE_URL=
ASYNC_DATABASE_URL=
